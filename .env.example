# Copia este fichero como .env.local para desarrollo local.
# Nunca subas el .env.local real al repositorio.

# Postgres. En Render/Neon/Supabase suele requerir TLS:
#   postgres://usuario:password@host:puerto/db?sslmode=require
DATABASE_URL=postgres://usuario:password@localhost:5432/atlas

# IA para clasificar solicitudes e incidencias (Groq). Opcional:
# sin esta clave Atlas usa el clasificador heurístico por palabras clave.
GROQ_API_KEY=

# Email (Resend) para avisos de prioridad alta. Opcional.
RESEND_API_KEY=
